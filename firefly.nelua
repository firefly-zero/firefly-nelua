##[[
-- Credits note: this code was heavily inspired by wasm4 setup code:
-- https://github.com/aduros/wasm4/blob/main/cli/assets/templates/nelua/src/wasm4.nelua

-- Don't search for the entry point symbol:
-- https://lld.llvm.org/WebAssembly.html#cmdoption-no-entry
ldflags '-Wl,--no-entry'

-- WebAssembly execution model set to reactor (makes `main` not required):
-- https://clang.llvm.org/docs/ClangCommandLineReference.html#cmdoption-clang-mexec-model
cflags '-mexec-model=reactor'

-- https://github.com/edubart/nelua-lang/blob/master/lualib/nelua/typedefs.lua#L219

-- Disable entry point generation for the GC.
context.rootpragmas.nogcentry = true

-- Changes how messages are written to stderr when a runtime error occur.
context.rootpragmas.writestderr = "hooked"

-- "Changes abort semantics"
context.rootpragmas.abort = "trap"
]]

require 'span'
require 'allocators.default'

-- https://codeberg.org/Andre-LA/nelua-gamercade/src/branch/main/gamercade.nelua

local ff = @record{}


-- CALLBACKS --


## function ff.value.init(cb)
  local function _init(): void <cexport, cattribute'export_name("init")', entrypoint>
    ## if not pragmas.nogc then
      gc:init(nilptr)
    ## end
    -- This will run all the code in the top scopes
    local function nelua_main(argc: cint, argv: *cstring): cint
      <cimport,nodecl> end
    nelua_main(0, nilptr)
    ## if cb.init then
      #[cb.init]#()
    ## end
  end

  local function _update(): void <cexport, cattribute'export_name("update")'>
    ## if cb.update then
      #[cb.update]#()
    ## end

    ## if not pragmas.nogc then
      gc:step()
    ## end
  end

  ## if cb.render then
    local function _render(): void <cexport, cattribute'export_name("render")'>
      #[cb.render]#()
    end
  ## end

  ## if cb.before_exit then
    local function _before_exit(): void <cexport, cattribute'export_name("before_exit")'>
      #[cb.before_exit]#()
    end
  ## end
## end


-- CONSTANTS AND TYPES --


global ff.width = 240
global ff.height = 160

global ff.Point = @record{
  x: integer,
  y: integer,
}

global ff.Size = @record{
  w: integer,
  h: integer,
}

global ff.Angle: type = @record{_a: float32}

global ff.Color = @enum{
  -- No color (100% transparency). Default.
  None = 0,
  -- Black color: #1A1C2C.
  Black = 1,
  -- Purple color: #5D275D.
  Purple = 2,
  -- Red color: #B13E53.
  Red = 3,
  -- Orange color: #EF7D57.
  Orange = 4,
  -- Yellow color: #FFCD75.
  Yellow = 5,
  -- Light green color: #A7F070.
  LightGreen = 6,
  -- Green color: #38B764.
  Green = 7,
  -- Dark green color: #257179.
  DarkGreen = 8,
  -- Dark blue color: #29366F.
  DarkBlue = 9,
  -- Blue color: #3B5DC9.
  Blue = 10,
  -- Light blue color: #41A6F6.
  LightBlue = 11,
  -- Cyan color: #73EFF7.
  Cyan = 12,
  -- White color: #F4F4F4.
  White = 13,
  -- Light gray color: #94B0C2.
  LightGray = 14,
  -- Gray color: #566C86.
  Gray = 15,
  -- Dark gray color: #333C57.
  DarkGray = 16
}

global ff.RGB = @record{
  r: uint8,
  g: uint8,
  b: uint8,
}

global ff.Style = @record{
  fill_color: ff.Color,
  stroke_color: ff.Color,
  stroke_width: integer,
}

global ff.LineStyle = @record{
  color: ff.Color,
  width: integer,
}


global ff.File = @record{ _b: span(byte) }
global ff.Font = @record{ _b: span(byte) }
global ff.Image = @record{ _b: span(byte) }

global ff.SubImage = @record{
  _b: span(byte),
  _p: ff.Point,
  _s: ff.Size,
}

global ff.Peer = @record{ _p: uint8 }
global ff.Peer.combined = ff.Peer{0xFF}
global ff.combined = ff.Peer{0xFF}

global ff.Pad = @record{
  x: integer,
  y: integer,
}

global ff.DPad8 = @record{
  left: boolean,
  right: boolean,
  up: boolean,
  down: boolean,
}

global ff.DPad4 = @enum{
  None = 0,
  Right,
  Up,
  Left,
  Down,
}

global ff.Buttons = @record{
  s: boolean,
  e: boolean,
  w: boolean,
  n: boolean,
}


-- CONSTRUCTORS --


function ff.p(x: integer, y: integer): ff.Point
  return ff.Point{x = x, y = y}
end

-- Define an angle in radians where Tau (doubled Pi) is the full circle.
function ff.radians(a: float32): ff.Angle
  return ff.Angle{a}
end

-- Define an angle in radians where 360.0 is the full circle.
function ff.degrees(a: float32): ff.Angle
  local pi <comptime> = 3.14159265358979323846264338327950288419716939937510582097494459
  return ff.Angle{a * pi / 180.0}
end

function ff.solid(c: ff.Color): ff.Style
  return ff.Style{fill_color = c}
end

function ff.outlined(c: ff.Color, w: integer): ff.Style
  return ff.Style{stroke_color = c, stroke_width = w}
end

function ff.l(c: ff.Color, w: integer): ff.LineStyle
  return ff.LineStyle{color = c, width = w}
end

function ff.File.from_bytes(b: span(byte)): ff.File
  return ff.File{b}
end


-- METHODS --

function ff.File:to_image(): ff.Image
  return ff.Image{self._b}
end

function ff.File:to_font(): ff.Font
  return ff.Font{self._b}
end

function ff.File:to_bytes(): span(byte)
  return self._b
end

function ff.Image:sub(p: ff.Point, s: ff.Size): ff.SubImage
  return ff.SubImage {
    _b = self._b,
    _p = p,
    _s = s,
  }
end

function ff.Pad:to_dpad4(): ff.DPad4
  local function abs(i: integer): integer
    if i < 0 then
      return -i
    end
    return i
  end

  local threshold <comptime> = 300
  local x = self.x
  local y = self.y
  local abs_x = abs(x)
  local abs_y = abs(y)
  if y > threshold and y > abs_x then
    return ff.DPad4.Up
  elseif y < -threshold and -y > abs_x then
    return ff.DPad4.Down
  elseif x > threshold and x > abs_y then
    return ff.DPad4.Right
  elseif x < -threshold and -x > abs_y then
    return ff.DPad4.Left
  end
  return ff.DPad4.None
end

function ff.Pad:to_dpad8(): ff.DPad8
  local threshold <comptime> = 400
  return ff.DPad8{
    left = self.x <= -threshold,
    right = self.x >= threshold,
    down = self.y <= -threshold,
    up = self.y > threshold,
  }
end



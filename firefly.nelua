-- FUNCTIONS: GRAPHICS --


function ff.clear_screen(c: ff.Color): void
  _clear_screen(c)
end

function ff.set_color(c: ff.Color, rgb: ff.RGB): void
  _set_color(c, rgb.r, rgb.g, rgb.b)
end

function ff.flip_x(): void
  _flip_x()
end

function ff.flip_y(): void
  _flip_y()
end

function ff.draw_point(p: ff.Point, c: ff.Color): void
  _draw_point(p.x, p.y, c)
end

function ff.draw_line(a: ff.Point, b: ff.Point, s: ff.LineStyle): void
  _draw_line(a.x, a.y, b.x, b.y, s.color, s.width)
end

function ff.draw_rect(p: ff.Point, b: ff.Size, s: ff.Style): void
  _draw_rect(p.x, p.y, b.w, b.h, s.fill_color, s.stroke_color, s.stroke_width)
end

function ff.draw_rounded_rect(p: ff.Point, b: ff.Size, corners: ff.Size, s: ff.Style): void
  _draw_rounded_rect(p.x, p.y, b.w, b.h, corners.w, corners.h, s.fill_color, s.stroke_color, s.stroke_width)
end

function ff.draw_circle(p: ff.Point, d: integer, s: ff.Style): void
  _draw_circle(p.x, p.y, d, s.fill_color, s.stroke_color, s.stroke_width)
end

function ff.draw_ellipse(p: ff.Point, b: ff.Size, s: ff.Style): void
  _draw_ellipse(p.x, p.y, b.w, b.h, s.fill_color, s.stroke_color, s.stroke_width)
end

function ff.draw_triangle(a: ff.Point, b: ff.Point, c: ff.Point, s: ff.Style): void
  _draw_triangle(a.x, a.y, b.x, b.y, c.x, c.y, s.fill_color, s.stroke_color, s.stroke_width)
end

function ff.draw_arc(p: ff.Point, d: integer, start: ff.Angle, sweep: ff.Angle, s: ff.Style): void
  _draw_arc(p.x, p.y, d, start._a, sweep._a, s.fill_color, s.stroke_color, s.stroke_width)
end

function ff.draw_sector(p: ff.Point, d: integer, start: ff.Angle, sweep: ff.Angle, s: ff.Style): void
  _draw_sector(p.x, p.y, d, start._a, sweep._a, s.fill_color, s.stroke_color, s.stroke_width)
end

function ff.draw_text(t: string, f: ff.Font, p: ff.Point, c: ff.Color): void
  _draw_text(t, #t, &f._b[0], #f._b, p.x, p.y, c)
end

function ff.draw_qr(t: string, p: ff.Point, black: ff.Color, white: ff.Color): void
  _draw_qr(t, #t, p.x, p.y, black, white)
end

function ff.draw_image(i: ff.Image, p: ff.Point): void
  _draw_image(&i._b[0], #i._b, p.x, p.y)
end

function ff.draw_sub_image(i: ff.SubImage, p: ff.Point): void
  _draw_sub_image(&i._b[0], #i._b, p.x, p.y, i._p.x, i._p.y, i._s.w, i._s.h)
end

function ff.draw_sub_tile(i: ff.SubImage, p: ff.Point, s: ff.Size): void
  _draw_sub_tile(&i._b[0], #i._b, p.x, p.y, s.w, s.h, i._p.x, i._p.y, i._s.w, i._s.h)
end

function ff.draw_nine_slice(i: ff.SubImage, p: ff.Point, s: ff.Size): void
  _draw_nine_slice(&i._b[0], #i._b, p.x, p.y, s.w, s.h, i._p.x, i._p.y, i._s.w, i._s.h)
end

function ff.set_canvas(i: ff.Image): void
  _set_canvas(&i._b[0], #i._b)
end

function ff.unset_canvas(): void
  _unset_canvas()
end


-- FUNCTIONS: INPUT --


function ff.read_pad(p: ff.Peer): (ff.Pad, boolean)
  local raw = _read_pad(p._p)
  local pressed = raw ~= 0xffff
  if not pressed then
    return {}, false
  end
  local pad = ff.Pad{
    x = integer(int16(raw >> 16)),
    y = integer(int16(raw)),
  }
  return pad, true
end

function ff.read_buttons(p: ff.Peer): ff.Buttons
  -- Check if the given uint32 value has the given bit set.
  local function has_bit_set(val: uint32, bit: uint8): boolean <inline>
    return (val >> bit) & 0b1 ~= 0
  end

  local raw = _read_buttons(p._p)
  return ff.Buttons{
    s = has_bit_set(raw, 0),
    e = has_bit_set(raw, 1),
    w = has_bit_set(raw, 2),
    n = has_bit_set(raw, 3),
  }
end


-- FUNCTIONS: FS --


function ff.get_file_size(path: string): integer
  return _get_file_size(path, #path)
end

function ff.load_file(path: string): ff.File
  local size = _get_file_size(path, #path)
  local buf: span(byte)
  buf = default_allocator:xspanrealloc(buf, size)
  _load_file(path, #path, &buf[0], #buf)
  return ff.File{buf}
end

function ff.dump_file(path: string, buf: span(byte)): void
  _dump_file(path, #path, &buf[0], #buf)
end

function ff.remove_file(path: string): void
  _remove_file(path, #path)
end



## context.rootpragmas.nogc = true

local ff = require 'firefly'

local function render()
  ff.clear_screen(ff.Color.Green)
  ff.draw_triangle(
    {x=40, y=60},
    {x=60, y=40},
    {x=80, y=60},
    {
      fill_color=ff.Color.Red,
      stroke_color=ff.Color.Blue,
      stroke_width=1,
    }
  )
end

## ff.value.init({render = render})
